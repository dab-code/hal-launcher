<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12 and higher. The same rules as backup_rules.xml:
   back up and transfer the HAL settings, but not the notification texts
   (quiet_notifications.json), the reminder session and the permission request state.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="quiet_notifications.json" />
        <exclude domain="sharedpref" path="hal_reminder_session.xml" />
        <exclude domain="sharedpref" path="hal_break_end.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="quiet_notifications.json" />
        <exclude domain="sharedpref" path="hal_reminder_session.xml" />
        <exclude domain="sharedpref" path="hal_break_end.xml" />
    </device-transfer>
</data-extraction-rules>
